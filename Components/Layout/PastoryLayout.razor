@inherits LayoutComponentBase
@inject Microsoft.Extensions.Localization.IStringLocalizer<RaphaelFreiWeb.Resources.Resources> Loc

<div class="pastory-page-wrapper">
    <header class="pastory-top-header">
        <a href="/" class="pastory-back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            @Loc["PastoryLayout_BackHome"]
        </a>
    </header>
    
    <main class="pastory-main-content">
        @Body
    </main>

    <footer class="bottom-footer">
        <div class="footer-container">
            <div class="footer-info">
                <p>© @YearDetails() Raphael Frei. All rights reserved.</p>
                <p class="built-with">Built with <span class="accent">.NET Blazor</span>.</p>
            </div>

            <div class="footer-actions">
                <div class="language-wrapper">
                    <CultureSelector/>
                </div>
            </div>
        </div>
    </footer>
</div>

@code{
    private string YearDetails () {
        int startYear = 2021;
        int currentYear = DateTime.Now.Year;
        return currentYear == startYear ? currentYear.ToString() : $"{startYear} - {currentYear}";
    }
}
