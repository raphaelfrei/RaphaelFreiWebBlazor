@inherits LayoutComponentBase

<div class="chromaku-page-wrapper">
    <!-- Header -->
    <header class="chromaku-header">
        <div class="chromaku-header-inner">
            <a href="/" class="chromaku-back-badge">
                <span class="back-arrow">←</span>
                <span>Back to Portfolio</span>
            </a>

            <div class="chromaku-brand">
                <a href="/chromaku" class="chromaku-brand-link">
                    <img src="/images/chromaku-icon.svg" alt="Chromaku Icon" class="chromaku-nav-icon" />
                    <span class="chromaku-brand-title">CHROMAKU</span>
                </a>
            </div>

            <nav class="chromaku-nav">
                <a href="/chromaku/privacy" class="chromaku-nav-btn">
                    Privacy
                </a>
            </nav>
        </div>
    </header>

    <main class="chromaku-main">
        @Body
    </main>

    <footer class="chromaku-footer">
        <div class="chromaku-footer-inner">
            <p class="footer-copy">
                © 2026 FreiLabs. All rights reserved.
            </p>

            <div class="footer-links">
                <a href="/chromaku/privacy" class="footer-link">Privacy Policy</a>
                <a href="/" class="footer-link">Portfolio</a>
            </div>
        </div>
    </footer>
</div>
