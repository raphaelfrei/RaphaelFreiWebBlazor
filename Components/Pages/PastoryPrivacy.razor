@page "/pastory/privacy"
@layout Layout.PastoryLayout

<PageTitle>@Loc["PastoryPrivacy_Title"] - Pastory</PageTitle>

<div class="privacy-container">
    <div class="privacy-header">
        <div class="icon-wrapper">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>
        <h1>@Loc["PastoryPrivacy_Title"]</h1>
        <p class="last-updated">@Loc["PastoryPrivacy_LastUpdated"]</p>
    </div>

    <div class="privacy-content">
        <p>@Loc["PastoryPrivacy_Intro"]</p>
        
        <h2>@Loc["PastoryPrivacy_H1"]</h2>
        <p>@Loc["PastoryPrivacy_P1"]</p>
        
        <h2>@Loc["PastoryPrivacy_H2"]</h2>
        <p>@Loc["PastoryPrivacy_P2"]</p>
        
        <h2>@Loc["PastoryPrivacy_H3"]</h2>
        <p>@Loc["PastoryPrivacy_P3"]</p>

        <h2>@Loc["PastoryPrivacy_H4"]</h2>
        <p>@Loc["PastoryPrivacy_P4"]</p>
        
        <h2>@Loc["PastoryPrivacy_H5"]</h2>
        <p>@Loc["PastoryPrivacy_P5"]</p>
        
        <h2>@Loc["PastoryPrivacy_H6"]</h2>
        <p>@Loc["PastoryPrivacy_P6"]</p>
        
        <div class="contact-section">
            <p>@Loc["PastoryPrivacy_Contact"]</p>
            <a href="/pastory" class="btn-back">@Loc["Pastory_BackBtn"]</a>
        </div>
    </div>
</div>
